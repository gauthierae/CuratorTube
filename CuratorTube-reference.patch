+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  setDataStatus('success', `Exported ${feeds.length} channel${feeds.length > 1 ? 's' : ''}.`);
+}
+
+// Accepts a CuratorTube JSON backup or an OPML file from another reader.
+function parseImport(text) {
+  const trimmed = text.trim();
+  if (trimmed.startsWith('{')) {
+    const data = JSON.parse(trimmed);
+    if (!data || !Array.isArray(data.feeds)) throw new Error('Not a CuratorTube backup.');
+    return data.feeds.map(f => ({ name: f && f.name, url: f && f.url, addedAt: f && f.addedAt }));
+  }
+  const xml = new DOMParser().parseFromString(trimmed, 'text/xml');
+  if (xml.querySelector('parsererror')) throw new Error('Unrecognised file format.');
+  return Array.from(xml.querySelectorAll('outline[xmlUrl]')).map(o => ({
+    name: o.getAttribute('title') || o.getAttribute('text') || '',
+    url:  o.getAttribute('xmlUrl'),
+  }));
+}
+
+async function importFeeds(file) {
+  try {
+    const entries = parseImport(await file.text());
+    let added = 0, skipped = 0;
+    const fresh = [];
+    for (const e of entries) {
+      const url = typeof e.url === 'string' ? e.url.trim() : '';
+      if (!/^https?:\/\//i.test(url) || feeds.some(f => f.url === url)) { skipped++; continue; }
+      const feed = {
+        id:          uid(),
+        name:        (typeof e.name === 'string' && e.name.trim()) || 'Unknown Channel',
+        url,
+        addedAt:     typeof e.addedAt === 'string' ? e.addedAt : new Date().toISOString(),
+        lastFetched: null,
+      };
+      feeds.push(feed);
+      fresh.push(feed.id);
+      added++;
+    }
+    saveFeeds();
+    renderChannels();
