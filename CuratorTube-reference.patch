+function exportFeeds() {
+  if (feeds.length === 0) { setDataStatus('error', 'Nothing to export yet.'); return; }
+  const data = {
+    app: 'CuratorTube',
+    version: 1,
+    exportedAt: new Date().toISOString(),
+    videoLimit,
+    feeds: feeds.map(({ name, url, addedAt }) => ({ name, url, addedAt })),
+  };
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
